# Variabel untuk docker compose (deploy). Salin menjadi .env lalu isi nilai asli.
# JANGAN commit file .env. Di Jenkins, isinya disimpan sebagai Secret file 'cucikilat-env'.
APP_PORT=8081
APP_URL=http://localhost:8081
APP_KEY=
DB_DATABASE=cucikilat
DB_USERNAME=cucikilat
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
